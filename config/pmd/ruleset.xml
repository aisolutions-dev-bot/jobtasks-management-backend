<?xml version="1.0"?>
<ruleset name="AI Solutions Java Ruleset"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd">

    <description>Service rules for decomposition, maintainability, and error handling.</description>
    <rule ref="category/java/design.xml/GodClass"/>
    <rule ref="category/java/design.xml/NcssCount">
        <properties>
            <property name="classReportLevel" value="400"/>
            <property name="methodReportLevel" value="40"/>
        </properties>
    </rule>
    <rule ref="category/java/design.xml/CouplingBetweenObjects"/>
    <rule ref="category/java/errorprone.xml/AvoidCatchingGenericException"/>
    <rule ref="category/java/bestpractices.xml/UnusedPrivateField"/>
    <rule ref="category/java/errorprone.xml/AvoidDuplicateLiterals"/>
</ruleset>
